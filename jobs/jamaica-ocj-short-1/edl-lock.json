  },
  {
   "t0": 6.16,
   "t1": 12.454,
   "text": "The airport is in Boscobel, Saint Mary, about fifteen kilometres east of Ocho Rios.",
   "disclosure": false,
   "facts": [
    "o001"
   ],
   "need": [
    "boscobel-road",
    "driving"
   ]
  },
  {
   "t0": 12.749,
   "t1": 19.512,
   "text": "The airport lists taxi or coach hire, and taxis are available on site when needed, for an extra fee.",
   "disclosure": false,
   "facts": [
    "o005"
   ],
   "need": [
    "boscobel-road",
    "driving"
   ]
  },
  {
   "t0": 19.84,
   "t1": 25.344,
   "text": "Or book a private transfer before you land, so your driver is arranged in advance.",
   "disclosure": false,
   "facts": [],
   "need": [
    "driving",
    "highway"
   ]
  },
  {
   "t0": 27.159,
   "t1": 32.748,
   "text": "Driving yourself? Jamaica drives on the left, so take it slowly on the coast road.",
   "disclosure": false,
   "facts": [
    "f1014"
   ],
   "need": [
    "highway-aerial",
    "driving"
   ]
  },
  {
